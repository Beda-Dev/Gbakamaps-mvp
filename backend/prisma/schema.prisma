// =============================================================================
// Schéma repris et adapté de l'ancien projet (le schéma était le meilleur
// artefact de l'audit — contraintes, cascades et index corrects).
// Changements par rapport à l'ancien projet :
//   - User.id devient un identifiant généré par nous (auth maison, plus de
//     Firebase UID) + ajout du hash de mot de passe et d'une table Session
//   - Stop.source distingue les arrêts importés d'OSM des arrêts créés par
//     la communauté (corrige le bug osmId=BigInt(Date.now()) de l'ancien code)
//   - OfflineZone retirée du MVP (fonctionnalité reportée en V2/V3, cf. audit)
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// AUTHENTIFICATION (gérée nous-mêmes — sessions opaques, pas de JWT client)
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions  Session[]
  favorites Favorite[]
  reports   Report[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

// Sessions opaques stockées en base — permet la révocation immédiate
// (contrairement à un JWT auto-suffisant), cf. décision d'architecture.
model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// DONNÉES MÉTIER
// -----------------------------------------------------------------------------

model Stop {
  id       String   @id @default(uuid())
  name     String?
  lat      Float
  lon      Float
  stopType StopType @default(BUS_STOP)

  // Origine de la donnée : import batch OSM ou création communautaire.
  // Corrige l'ancien pipeline qui mélangeait les deux sans distinction claire.
  source     StopSource @default(COMMUNITY)
  osmId      BigInt?    @unique // uniquement renseigné si source = OSM

  // Tags enrichis
  shelter    Boolean? @default(false)
  bench      Boolean? @default(false)
  wheelchair Boolean? @default(false)

  // Tags spécifiques transport informel ivoirien
  gbaka    Boolean? @default(false)
  woroworo Boolean? @default(false)
  taxi     Boolean? @default(false)
  mototaxi Boolean? @default(false)

  verified    Boolean  @default(false)
  lastUpdated DateTime @default(now())

  // Colonne géographique PostGIS, maintenue par un trigger SQL (cf. migration
  // add_postgis_geography) à partir de lat/lon. Prisma ne modélise pas ce
  // type nativement : `Unsupported` l'expose pour que le schéma corresponde
  // à la base réelle, mais toutes les requêtes dessus passent par $queryRaw
  // (voir stops.service.ts). Corrige la limite identifiée à l'audit : les
  // recherches de proximité ne reposaient que sur une bounding box + calcul
  // Haversine en JavaScript, non indexé.
  geog Unsupported("geography(Point, 4326)")?

  favorites Favorite[]
  reports   Report[]
  stopLines StopLine[]

  @@index([lat, lon])
  @@index([geog(ops: raw("gist_geography_ops"))], type: Gist)
  @@map("stops")
}

enum StopSource {
  OSM
  COMMUNITY
}

enum StopType {
  BUS_STOP
  GBAKA_STOP
  WORO_WORO_STOP
  TAXI_STAND
  MOTO_TAXI_STAND
  PLATFORM
  STATION
}

model TransportLine {
  id            String        @id @default(uuid())
  name          String
  shortName     String?
  color         String?       @default("#0A9396")
  transportType TransportType
  operator      String?
  fare          Float?
  // false = valeur indicative (placeholder pré-rempli à l'import à partir
  // d'une recherche réelle sur les tarifs moyens par mode de transport, cf.
  // PROJECT_MEMORY.md §12.2), true = définie/confirmée par un administrateur
  // via PATCH /api/admin/lines/:id. Décision produit du 2026-09-06 : le
  // tarif par ligne n'est jamais inventé comme une vérité — c'est
  // l'administrateur qui fait foi, l'estimation n'est qu'un point de
  // départ affiché comme tel. Le script d'import ne touche JAMAIS `fare`
  // une fois `fareVerified=true`.
  fareVerified  Boolean       @default(false)
  active        Boolean       @default(true)

  // Référence externe (ex: route_id GTFS) permettant de ré-exécuter le
  // script d'import sans dupliquer les lignes (upsert par ce champ).
  externalRef String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stopLines StopLine[]

  @@map("transport_lines")
}

enum TransportType {
  BUS
  GBAKA
  WORO_WORO
  TAXI
  MOTO_TAXI
}

model StopLine {
  id        String  @id @default(uuid())
  stopId    String
  lineId    String
  // Position de l'arrêt dans le sens `direction` de la ligne (0 = premier
  // arrêt de ce sens). Renseigné depuis stop_times.txt/trips.txt (GTFS
  // JungleBus) à partir d'un "voyage représentatif" par (ligne, sens) —
  // voir import-gtfs.ts. Null si l'arrêt n'apparaît que sur une variante de
  // trajet non retenue comme représentative (rare, cas de branches).
  sequence  Int?
  // Sens de circulation (repris de trip_headsign, ex: "Gare Sud" — plus
  // parlant pour l'utilisateur qu'un simple 0/1 direction_id). Deux sens
  // d'une même ligne peuvent desservir des arrêts entièrement différents
  // (vérifié empiriquement sur ce jeu de données — pas une supposition),
  // donc chaque ligne physique peut avoir jusqu'à deux groupes d'arrêts
  // disjoints partageant le même lineId mais un `direction` différent.
  direction String?
  // Secondes écoulées depuis le premier arrêt du voyage représentatif de ce
  // (ligne, sens) — permet d'estimer un temps de trajet ENTRE DEUX ARRÊTS de
  // la même ligne/sens par simple soustraction, sans dépendre de l'heure
  // absolue (obsolète depuis 2021, cf. README GTFS) : seul l'écart relatif
  // entre arrêts est utilisé, jamais l'horaire absolu.
  secondsFromRouteStart Int?

  stop Stop          @relation(fields: [stopId], references: [id], onDelete: Cascade)
  line TransportLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  // AVANT le 2026-09-06 : unique([stopId, lineId]) — bug réel découvert en
  // testant le planificateur de trajet (§12.3) : un arrêt terminus/hub
  // partagé par les DEUX sens d'une même ligne (cas réel, pas rare — ex.
  // "Terminus Hôtel de Ville" sur la ligne 25) ne pouvait avoir qu'UNE seule
  // ligne stockée, le second sens importé écrasant silencieusement le
  // premier (sequence/direction/secondsFromRouteStart corrompus). D'où
  // l'ajout de `direction` à la contrainte d'unicité : chaque sens d'une
  // ligne partageant un arrêt obtient désormais sa propre ligne.
  @@unique([stopId, lineId, direction])
  @@index([lineId, direction, sequence])
  @@map("stop_lines")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  stopId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stop Stop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([userId, stopId])
  @@map("favorites")
}

model Report {
  id          String       @id @default(uuid())
  userId      String
  stopId      String?
  reportType  ReportType
  title       String
  description String?
  imageUrl    String?
  lat         Float?
  lon         Float?
  status      ReportStatus @default(PENDING)
  moderatedBy String?
  moderatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stop Stop? @relation(fields: [stopId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("reports")
}

enum ReportType {
  MISSING_STOP
  INCORRECT_INFO
  DAMAGE
  SAFETY_ISSUE
  NEW_LINE
  SCHEDULE_CHANGE
  DUPLICATE_STOP
  OTHER
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
  RESOLVED
}
