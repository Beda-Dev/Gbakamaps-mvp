VITE_API_URL=http://localhost:4000/api

# Clé gratuite requise pour un rendu de carte détaillé (tuiles vectorielles).
# Créer un compte gratuit sur https://cloud.maptiler.com (pas de carte
# bancaire, ~100 000 requêtes/mois gratuites), puis coller la clé ici.
# Si absente, l'app bascule automatiquement sur des tuiles OSM moins
# détaillées (voir frontend/src/components/StopsMap.tsx).
VITE_MAPTILER_KEY=
# Optionnel — clé de secours (même compte ou un second compte gratuit) :
# si la première échoue réellement (quota dépassé, panne), bascule
# automatique dessus avant le repli final sur OSM.
VITE_MAPTILER_KEY_2=
