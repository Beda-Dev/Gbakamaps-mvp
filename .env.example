# =============================================================================
# Copier ce fichier en .env et remplir les valeurs avant `docker compose up -d`
# =============================================================================

# --- Base de données (Docker) ---
POSTGRES_USER=gbakamap
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=gbakamap
POSTGRES_PORT=5433
# Utilisée par le backend (nom d'hôte = nom du service docker-compose "db")
# Note: à l'intérieur du réseau Docker, le port interne du conteneur reste
# toujours 5432 — seul le port EXPOSÉ sur l'hôte (POSTGRES_PORT) change,
# pour éviter un conflit avec un PostgreSQL déjà installé sur la machine.
DATABASE_URL=postgresql://gbakamap:changeme_dev_password@db:5432/gbakamap?schema=public

# --- Backend ---
NODE_ENV=development
PORT=4000
# Génère une valeur avec: openssl rand -base64 32
SESSION_SECRET=changeme_generate_a_real_random_secret
SESSION_COOKIE_NAME=gbakamap_session
SESSION_TTL_HOURS=720

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Services externes ---
# Calcul d'itinéraire (OpenRouteService). Compte gratuit requis (pas de
# carte bancaire) : https://openrouteservice.org/dev/#/signup
# Remplace OSRM (serveur démo public) — vérifié empiriquement que son
# routage ne distingue pas réellement les profils voiture/vélo/marche.
ORS_API_KEY=
# Optionnel — clé de secours (même compte ou un second compte gratuit) :
# ORS applique une limite de débit par minute en plus du quota journalier ;
# une seconde clé absorbe les pics sans jamais bloquer l'utilisateur.
ORS_API_KEY_2=
# Optionnel — dernier recours si les deux clés ORS échouent. Compte gratuit :
# https://www.graphhopper.com/pricing/ (distingue réellement les profils,
# contrairement à OSRM démo). Si absent, le système renvoie une erreur claire
# plutôt que de dégrader silencieusement vers un fournisseur non vérifié.
GRAPHHOPPER_API_KEY=
